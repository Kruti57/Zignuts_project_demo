# ==============================================================================
# AI Meeting Notes & Action Tracker - Environment Configuration
# ==============================================================================

# Django Secret Key & Debug Mode
SECRET_KEY=django-insecure-zignuts-assessment-ai-tracker-secret-key-2026-demo
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (MySQL / MariaDB or SQLite)
# DB_ENGINE choices: django.db.backends.mysql, django.db.backends.sqlite3
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=ai_meeting_tracker
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# AI Providers Configuration
# Set your Gemini or OpenAI API Key here.
# If no key is supplied, the built-in intelligent structured Mock AI is used.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=auto
